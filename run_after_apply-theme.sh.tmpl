#!/bin/bash
# Apply current theme to all downstream configs via Python theme pipeline
set -euo pipefail

eval "$({{ .brew_prefix }}/bin/brew shellenv)"

if ! command -v python3 &>/dev/null; then
    echo "python3 not installed yet, skipping theme apply"
    exit 0
fi

DOTFILES_DIR="{{ .chezmoi.homeDir }}/.config/dotfiles"
if [ ! -f "$DOTFILES_DIR/theme_db.py" ]; then
    echo "Theme scripts not deployed yet, skipping"
    exit 0
fi

# Apply current theme, or default to standard-light on fresh install
CURRENT_THEME_FILE="{{ .chezmoi.homeDir }}/.config/dotfiles/current-theme"
if [ ! -f "$CURRENT_THEME_FILE" ]; then
    echo "No theme set, defaulting to standard-light"
    THEME="standard-light"
else
    THEME=$(cat "$CURRENT_THEME_FILE" | tr -d '[:space:]')
fi

echo "Applying theme: $THEME"
python3 -c "
import sys
sys.path.insert(0, '$DOTFILES_DIR')
from theme_db import build_db
from generators import generate_all, generate_xonsh
db = build_db()
if '$THEME' not in db:
    print('Unknown theme: $THEME', file=sys.stderr)
    sys.exit(1)
entry = db['$THEME']
generate_all(entry['palette'], '$THEME', entry['variant'])
generate_xonsh(entry['palette'], '$THEME', entry['variant'])
"

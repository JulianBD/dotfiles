[
  { "prefix": "M-g", "label": "goto", "scope": "global",
    "bindings": [
      { "key": "g",   "command": "consult-goto-line" },
      { "key": "M-g", "command": "consult-goto-line" },
      { "key": "o",   "command": "consult-outline" },
      { "key": "i",   "command": "consult-imenu" }
    ]
  },
  { "prefix": "M-s", "label": "search", "scope": "global",
    "bindings": [
      { "key": "l", "command": "consult-line" },
      { "key": "r", "command": "consult-ripgrep" },
      { "key": "f", "command": "consult-find" }
    ]
  },
  { "key": "C-x b",   "command": "consult-buffer",              "scope": "global" },
  { "key": "C-x 4 b", "command": "consult-buffer-other-window", "scope": "global" },
  { "key": "M-y",     "command": "consult-yank-pop",            "scope": "global" },
  { "key": "C-.",     "command": "embark-act",                   "scope": "global" },
  { "key": "C-;",     "command": "embark-dwim",                  "scope": "global" },
  { "key": "C-h B",   "command": "embark-bindings",              "scope": "global" },
  { "key": "C-x C-b", "command": "ibuffer",                     "scope": "global" },

  { "key": "<tab>",  "command": "corfu-complete",
    "scope": "mode", "keymap": "corfu-map" },

  { "prefix": "g", "label": "goto (hel)", "scope": "hel-state", "state": "normal",
    "bindings": [
      { "key": "o", "command": "consult-imenu" },
      { "key": "d", "command": "xref-find-definitions" }
    ]
  }
]

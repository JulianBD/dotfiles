# =============================================================================
# Brewfile — Layer 0: system packages, GUI apps, fonts
# Feature toggles: dev_tools, work_apps (see .chezmoi.toml.tmpl)
# Dev runtimes and CLI tools live in mise (~/.config/mise/config.toml)
# =============================================================================

# --- Taps -------------------------------------------------------------------
tap "d12frosted/emacs-plus"
tap "felixkratz/formulae"
tap "nikitabobko/tap"
{{ if .work_apps -}}
tap "hashicorp/tap"
tap "radiusmethod/awsd"
tap "theurichde/go-aws-sso"
{{ end -}}

# --- Shells ------------------------------------------------------------------
brew "bash"
brew "fish"
brew "fisher"
brew "zsh"
{{ if .dev_tools -}}
brew "nushell"
{{ end -}}

# --- Secrets -----------------------------------------------------------------
brew "gnupg"
brew "gopass"
brew "pinentry-mac"  # gpg-agent prompt with Keychain save — no per-shell passphrase prompts

# --- Core system tools (can't come from mise) --------------------------------
brew "coreutils"
brew "findutils"
brew "gawk"
brew "gnu-sed"
brew "grep"

# --- Build dependencies & native libs ----------------------------------------
{{ if .dev_tools -}}
brew "autoconf"
brew "automake"
brew "enchant"
brew "libgccjit"
brew "pkgconf"
{{ end -}}
brew "ffmpeg"
brew "imagemagick"
brew "numpy"
brew "poppler"

# --- CLI tools (brew-only or need native integration) ------------------------
# choose, delta, eza, fd, go-jsonnet, yarn live in mise — see mise/config.toml
brew "gh"
brew "m-cli"
brew "mise"
brew "pandoc"
brew "tmux"
brew "carapace"
brew "tree"
brew "watch"
{{ if .dev_tools -}}
brew "argc"
# Contracts for the olog schemas: validates instance data against constraints
# that JSON Schema cannot express, e.g. that every tool_result id matches a
# tool_use id. Not in mise's registry, hence brew.
brew "nickel"
brew "fselect"
brew "navi"
brew "parallel"
brew "socat"
{{ end -}}
{{ if .work_apps -}}
brew "radiusmethod/awsd/awsd"
{{ end -}}

# --- Desktop environment ----------------------------------------------------
cask "d12frosted/emacs-plus/emacs-plus-app@master"
brew "felixkratz/formulae/borders"
brew "felixkratz/formulae/sketchybar"

# --- GUI apps (casks) --------------------------------------------------------
# All machines
cask "1password"
cask "1password-cli"
cask "aerospace"
cask "ghostty"
cask "glide-browser"
cask "obsidian"
cask "spotify"
cask "zed"

{{ if .dev_tools -}}
# dev_tools
cask "visual-studio-code"
{{ end -}}

{{ if .work_apps -}}
# work_apps
cask "microsoft-edge"
cask "session-manager-plugin"
cask "redis-insight"
{{ end -}}

{{ if .dev_tools -}}
# dev_tools extras
cask "raindropio"
{{ end -}}

# --- Fonts -------------------------------------------------------------------
cask "font-aporetic"                # UI/prose only (Zed ui_font, Emacs variable-pitch)
cask "font-atkinson-hyperlegible"
cask "font-atkinson-hyperlegible-mono"
cask "font-atkinson-hyperlegible-next"
cask "font-eb-garamond"
cask "font-fira-code-nerd-font"     # FiraCode Nerd Font: monospace/coding font everywhere
cask "font-monaspace-nf"            # Monaspace Argon NF: kept installed while trying Fira Code
cask "font-monaspace-frozen"        # Monaspace Argon Frozen: Emacs-only, ligature stylistic
                                     # sets baked in (ligature.el can't toggle them at runtime)
cask "font-sketchybar-app-font"     # app-icon glyphs, not a text font

# --- VS Code extensions ------------------------------------------------------
{{ if .dev_tools -}}
vscode "github.copilot"
vscode "github.copilot-chat"
vscode "golang.go"
vscode "hashicorp.terraform"
vscode "mechatroner.rainbow-csv"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-python.vscode-python-envs"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode.makefile-tools"
vscode "mthierman.theme-flexoki"
{{ end -}}

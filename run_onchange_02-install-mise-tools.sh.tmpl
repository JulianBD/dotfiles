#!/bin/bash
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

eval "$({{ .brew_prefix }}/bin/brew shellenv)"

if ! command -v mise &>/dev/null; then
    echo "mise not found — install it via brew first (chezmoi apply again after brew finishes)"
    exit 1
fi

echo "Installing mise tools..."
mise install --yes

# Clear stale tool versions after each install so old majors don't
# accumulate (the recurring disk-space culprit). The weekly LaunchAgent
# additionally prunes on a schedule.
 echo "Pruning stale mise versions..."
mise prune --yes || true

#!/bin/bash
# Build SbarLua against the currently-active Lua version.
#
# The Lua version below is baked in at template-render time. When mise
# upgrades Lua, this comment changes, chezmoi detects the change, and the
# script re-runs to rebuild sketchybar.so against the new ABI. Without this,
# upgrading Lua silently segfaults sketchybar's rc on `require("sketchybar")`
# and you get an empty bar at the top of the screen.
#
# Lua version stamps: on a fresh machine mise is not installed yet when this
# template renders, so `output "mise" ...` would abort the whole apply. The
# lookPath guard renders "uninstalled" instead, and the script body exits
# early; once brew+mise land, the stamp changes and chezmoi re-runs this.
{{ $luaVer := "uninstalled" -}}
{{ if lookPath "mise" -}}
{{   $luaVer = output "mise" "current" "lua" | trim -}}
{{ end -}}
# Lua version: {{ $luaVer }}
set -euo pipefail

if ! command -v mise &>/dev/null; then
    echo "mise not found — skipping SbarLua build (re-runs once mise is installed)"
    exit 0
fi

LUA_VERSION="$(mise current lua | tr -d '[:space:]')"
if [ -z "$LUA_VERSION" ]; then
    echo "no lua installed via mise yet — skipping SbarLua build"
    exit 0
fi

echo "Building SbarLua against lua $LUA_VERSION..."
rm -rf /tmp/SbarLua ~/.local/share/sketchybar_lua
git clone --quiet https://github.com/FelixKratz/SbarLua.git /tmp/SbarLua
cd /tmp/SbarLua
make install
rm -rf /tmp/SbarLua

# Restart sketchybar so the new .so is loaded.
if command -v brew >/dev/null 2>&1 && brew services list 2>/dev/null | grep -q '^sketchybar'; then
  brew services restart sketchybar >/dev/null 2>&1 || true
fi
echo "SbarLua rebuilt"

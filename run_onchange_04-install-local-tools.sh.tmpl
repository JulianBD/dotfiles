#!/bin/bash
# local_tools hash: {{ include ".chezmoidata/local_tools.toml" | sha256sum }}
set -euo pipefail

eval "$({{ .brew_prefix }}/bin/brew shellenv)"
eval "$(mise activate bash)"

# Bootstrap Haskell toolchain via ghcup (recommended versions)
# ghci is bundled with ghc, not a separate component
ghcup install ghc
ghcup set ghc
ghcup install cabal
ghcup set cabal
ghcup install stack
ghcup install hls

export PATH="$HOME/.ghcup/bin:$HOME/.cabal/bin:$PATH"
export INSTALLDIR="$HOME/.local/bin"

mkdir -p "$INSTALLDIR"

{{ if hasKey . "source_builds" -}}
# ── Source builds ──
{{ range $name, $tool := .source_builds }}
(
  echo "── Building {{ $name }} ──"
  {{ if $tool.needs -}}
  {{ range $tool.needs -}}
  if ! command -v {{ . }} &>/dev/null; then
      echo "  SKIP: {{ $name }} requires {{ . }} but it's not on PATH"
      exit 0
  fi
  {{ end -}}
  {{ end -}}
  WORKDIR=$(mktemp -d)
  # Go writes its module cache mode 0555, and rm -rf cannot remove a read-only
  # directory. Without the chmod the trap fails, and under `set -e` that exit
  # status aborts the whole script *after* a successful build -- skipping every
  # section below. Verified 2026-08-25.
  trap 'chmod -R u+w "$WORKDIR" 2>/dev/null || true; rm -rf "$WORKDIR"' EXIT
  git clone {{ $tool.repo | quote }} "$WORKDIR"
  cd "$WORKDIR"
  {{ if hasKey $tool "version" -}}
  git checkout {{ $tool.version | quote }}
  {{ end -}}
  {{ $tool.build }}
  echo "  {{ $name }} installed to $INSTALLDIR"
)
{{ end }}
{{ end -}}

{{ if hasKey . "cloned_repos" -}}
# ── Cloned repos ──
{{ range $name, $tool := .cloned_repos }}
(
  echo "── Cloning {{ $name }} ──"
  DEST="{{ $tool.dest | replace "~" "$HOME" }}"
  if [ -d "$DEST" ]; then
      echo "  {{ $name }} already exists at $DEST"
      exit 0
  fi
  mkdir -p "$(dirname "$DEST")"
  # An upstream that has gone away must not abort provisioning: everything
  # below this point in the script is unrelated to it. Warn and carry on, the
  # same way a missing build dependency or link source does above.
  if ! git clone {{ $tool.repo | quote }} "$DEST"; then
      echo "  SKIP: {{ $name }} could not be cloned from {{ $tool.repo }}"
      exit 0
  fi
  echo "  {{ $name }} cloned to $DEST"
)
{{ end }}
{{ end -}}

{{ if hasKey . "local_links" -}}
# ── Local symlinks ──
{{ range $name, $tool := .local_links }}
(
  echo "── Linking {{ $name }} ──"
  SOURCE="{{ $tool.source | replace "~" "$HOME" }}"
  DEST="{{ if hasKey $tool "dest" }}{{ $tool.dest | replace "~" "$HOME" }}{{ else }}$HOME/.local/bin{{ end }}"
  if [ ! -f "$SOURCE" ]; then
      echo "  SKIP: {{ $name }} source not found at $SOURCE"
      exit 0
  fi
  mkdir -p "$DEST"
  ln -sf "$SOURCE" "$DEST/{{ $name }}"
  echo "  {{ $name }} linked to $DEST/{{ $name }}"
)
{{ end }}
{{ end -}}

echo "Local tools done."

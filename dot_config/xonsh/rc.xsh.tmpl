# rc.xsh — xonsh configuration
# Managed by chezmoi. Machine type: {{ .machine_type }}

import shutil

# Keep os.environ in sync with xonsh's $PATH so shutil.which()
# and subprocess calls see the same PATH we build below.
$UPDATE_OS_ENVIRON = True

# --- Homebrew ---
{{ if eq .chezmoi.arch "arm64" -}}
$PATH.insert(0, '/opt/homebrew/sbin')
$PATH.insert(0, '/opt/homebrew/bin')
{{ else -}}
$PATH.insert(0, '/usr/local/sbin')
$PATH.insert(0, '/usr/local/bin')
{{ end -}}

# --- PATH (from .chezmoidata/shell.yaml) ---
{{ range .shell.paths_absolute -}}
$PATH.insert(0, '{{ . }}')
{{ end -}}
{{ range .shell.paths_home -}}
$PATH.insert(0, $HOME + '/{{ . }}')
{{ end -}}

# --- xonsh venv bin (for CLIs installed via xpip) ---
import site as _site
$PATH.insert(0, str(_site.PREFIXES[0]) + '/bin')

# --- mise (shims for immediate PATH availability during rc) ---
$PATH.insert(0, $HOME + '/.local/share/mise/shims')

# --- Environment (from .chezmoidata/shell.yaml) ---
{{ range $k, $v := .shell.env -}}
${{ $k }} = '{{ $v }}'
{{ end -}}

# --- Secrets (from gopass) ---
$GITHUB_TOKEN = {{ gopass "chezmoi/github-token" | squote }}
{{ if eq .machine_type "work" -}}
$ATLASSIAN_API_TOKEN = {{ gopass "chezmoi/atlassian-token" | squote }}
{{ else -}}
$ANTHROPIC_API_KEY = {{ gopass "chezmoi/anthropic-api-key" | squote }}
$OPENAI_API_KEY = {{ gopass "chezmoi/openai-api-key" | squote }}
{{ end -}}

{{ if .cert_path -}}
# --- TLS certs (work: Zscaler) ---
$SSL_CERT_FILE = '{{ .cert_path }}'
$NODE_EXTRA_CA_CERTS = '{{ .cert_path }}'
$REQUESTS_CA_BUNDLE = '{{ .cert_path }}'
$AWS_CA_BUNDLE = '{{ .cert_path }}'
{{ end -}}

# --- Shell settings ---
$XONSH_HISTORY_BACKEND = 'sqlite'
$COMPLETIONS_CONFIRM = True
$AUTO_CD = True
$XONSH_AUTOPAIR = True

# --- Aliases (from .chezmoidata/shell.yaml) ---
{{ range .shell.aliases -}}
{{ $req := index . "requires" -}}
{{ if $req -}}
if shutil.which('{{ $req }}'):
    aliases['{{ .cmd }}'] = '{{ .expand }}'
{{ else -}}
aliases['{{ .cmd }}'] = '{{ .expand }}'
{{ end -}}
{{ end }}

# --- xonsh-local pip (install into xonsh's own Python) ---
import sys as _sys
aliases['xpip'] = lambda args: $[uv pip @(args) --python @(_sys.executable)]

# --- Zoxide ---
try:
    execx($(zoxide init xonsh))
except:
    pass

# --- Theme (prompt + syntax colors from prot-theme) ---
import os as _os
_theme_xsh = _os.path.expanduser('~/.config/xonsh/theme.xsh')
if _os.path.isfile(_theme_xsh):
    source @(_theme_xsh)

# --- Theme management alias ---
import sys as _sys
if _os.path.expanduser('~/.config/dotfiles') not in _sys.path:
    _sys.path.insert(0, _os.path.expanduser('~/.config/dotfiles'))

@aliases.register('theme')
@aliases.unthreadable
def _theme_alias(args):
    """Manage Prot themes: apply, pick, list, current, sync."""

    if not args:
        print('Usage: theme [apply <name> | pick | list | current | sync]')
        return 1

    cmd = args[0]

    if cmd == 'current':
        state = _os.path.expanduser('~/.config/dotfiles/current-theme')
        if _os.path.isfile(state):
            print(open(state).read().strip())
        else:
            print('No theme set')
        return

    if cmd == 'list':
        from theme_db import build_db
        db = build_db()
        for name in sorted(db):
            v = db[name]['variant']
            f = db[name]['family']
            print(f'  {name:40s} {v:5s}  ({f})')
        return

    if cmd == 'sync':
        import subprocess
        src = _os.path.expanduser('~/.local/share/dotfiles/theme-sources')
        repos = {
            'ef-themes': 'https://github.com/protesilaos/ef-themes.git',
            'modus-themes': 'https://github.com/protesilaos/modus-themes.git',
            'standard-themes': 'https://github.com/protesilaos/standard-themes.git',
            'doric-themes': 'https://github.com/protesilaos/doric-themes.git',
        }
        _os.makedirs(src, exist_ok=True)
        for name, url in repos.items():
            dest = _os.path.join(src, name)
            if _os.path.isdir(_os.path.join(dest, '.git')):
                print(f'Pulling {name}...')
                subprocess.run(['git', '-C', dest, 'pull', '--quiet'], check=False)
            else:
                print(f'Cloning {name}...')
                subprocess.run(['git', 'clone', '--quiet', '--depth', '1', url, dest], check=False)
        print('Sync complete')
        return

    if cmd == 'apply':
        if len(args) < 2:
            print('Usage: theme apply <name>')
            return 1
        name = args[1]

        from theme_db import build_db
        from generators import generate_all, generate_xonsh

        db = build_db()
        if name not in db:
            print(f'Unknown theme: {name}')
            print(f'Run "theme list" to see available themes')
            return 1

        entry = db[name]
        palette = entry['palette']
        variant = entry['variant']

        # Toggle macOS dark/light mode
        if shutil.which('m'):
            if variant == 'dark':
                $[m appearance --darkmode enable]
            else:
                $[m appearance --darkmode disable]

        # Update ghostty config to use this theme
        ghostty_config = _os.path.expanduser('~/.config/ghostty/config')
        if _os.path.isfile(ghostty_config):
            import re
            text = open(ghostty_config).read()
            if re.search(r'^theme\s*=', text, re.MULTILINE):
                text = re.sub(r'^theme\s*=.*$', f'theme = {name}', text, flags=re.MULTILINE)
            else:
                text += f'\ntheme = {name}\n'
            open(ghostty_config, 'w').write(text)

        # Run all generators
        generate_all(palette, name, variant)

        # Generate + hot-reload xonsh theme
        generate_xonsh(palette, name, variant)
        source @(_os.path.expanduser('~/.config/xonsh/theme.xsh'))

        # Record current theme
        state_dir = _os.path.expanduser('~/.config/dotfiles')
        _os.makedirs(state_dir, exist_ok=True)
        open(_os.path.join(state_dir, 'current-theme'), 'w').write(name + '\n')

        print(f'Applied theme: {name} ({variant})')
        return

    if cmd == 'pick':
        from theme_db import build_db
        db = build_db()

        # Build fzf input with color swatches
        lines = []
        for name in sorted(db):
            p = db[name]['palette']
            v = db[name]['variant']
            swatch_keys = ['bg-main', 'fg-main', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan']
            swatches = ''
            for k in swatch_keys:
                if k in p:
                    hex_c = p[k].lstrip('#')
                    r, g, b = int(hex_c[:2], 16), int(hex_c[2:4], 16), int(hex_c[4:6], 16)
                    swatches += f'\033[38;2;{r};{g};{b}m\u2588\u2588\033[0m'
            lines.append(f'{name:40s} {v:5s}  {swatches}')

        import subprocess
        try:
            result = subprocess.run(
                ['fzf', '--ansi', '--prompt', 'theme > ', '--no-multi'],
                input='\n'.join(lines), capture_output=True, text=True,
            )
            if result.returncode != 0:
                return
            chosen = result.stdout.strip().split()[0]
            if chosen:
                _theme_alias(['apply', chosen])
        except FileNotFoundError:
            print('fzf not installed')
            return 1
        return

    print(f'Unknown command: {cmd}')
    print('Usage: theme [apply <name> | pick | list | current | sync]')
    return 1

# --- Theme tab completion ---
def _theme_completer(prefix, line, begidx, endidx, ctx):
    words = line[:begidx].split()
    if len(words) == 1 and words[0] == 'theme':
        # Complete subcommands
        cmds = {'apply', 'pick', 'list', 'current', 'sync'}
        return {c for c in cmds if c.startswith(prefix)}
    if len(words) == 2 and words[0] == 'theme' and words[1] == 'apply':
        # Complete theme names
        try:
            from theme_db import build_db
            db = build_db()
            return {n for n in db if n.startswith(prefix)}
        except Exception:
            return set()
    return None

completer add theme _theme_completer start

# --- Carapace completions ---
try:
    $CARAPACE_BRIDGES = 'inshellisense'
    execx($(carapace _carapace xonsh))
except:
    pass

# --- Debugging (after tool inits to suppress startup noise) ---
$XONSH_SHOW_TRACEBACK = True

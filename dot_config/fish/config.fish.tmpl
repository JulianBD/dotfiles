if status is-interactive
    # Commands to run in interactive sessions can go here
end

# --- Homebrew ---
set -gx HOMEBREW_PREFIX "{{ .brew_prefix }}"
set -gx HOMEBREW_CELLAR "{{ .brew_prefix }}/Cellar"
set -gx HOMEBREW_REPOSITORY "{{ .brew_prefix }}"
fish_add_path "{{ .brew_prefix }}/bin" "{{ .brew_prefix }}/sbin"
if test -n "$MANPATH[1]"; set -gx MANPATH '' $MANPATH; end
if not contains "{{ .brew_prefix }}/share/info" $INFOPATH; set -gx INFOPATH "{{ .brew_prefix }}/share/info" $INFOPATH; end

# --- PATH (from .chezmoidata/shell.yaml) ---
{{ range .shell.paths_home -}}
fish_add_path "$HOME/{{ . }}"
{{ end -}}
{{ range .shell.paths_absolute -}}
fish_add_path "{{ . }}"
{{ end -}}

# --- mise ---
mise activate fish | source

# --- Environment (from .chezmoidata/shell.yaml) ---
{{ range $k, $v := .shell.env -}}
set -gx {{ $k }} {{ $v | quote }}
{{ end -}}
{{ if .work_apps -}}
# tfenv: work terraform releases predate darwin-arm64, so fetch x86_64 builds
# and run them under Rosetta. Work-only: a personal arm64 machine wants native.
set -gx TFENV_ARCH amd64
{{ end -}}

# --- Secrets (from gopass, gated per-machine by feature toggles) ---
{{ if .github_token -}}
set -gx GITHUB_TOKEN (gh auth token 2>/dev/null)
{{ end -}}
{{ if .atlassian -}}
set -gx ATLASSIAN_API_TOKEN (gopass show --password chezmoi/atlassian-token 2>/dev/null)
{{ end -}}
{{ if .ai_keys -}}
set -gx ANTHROPIC_API_KEY (gopass show --password chezmoi/anthropic-api-key 2>/dev/null)
set -gx OPENAI_API_KEY (gopass show --password chezmoi/openai-api-key 2>/dev/null)
{{ end -}}

{{ if .cert_path -}}
set -gx SSL_CERT_FILE {{ .cert_path | quote }}
set -gx NODE_EXTRA_CA_CERTS {{ .cert_path | quote }}
set -gx REQUESTS_CA_BUNDLE {{ .cert_path | quote }}
set -gx AWS_CA_BUNDLE {{ .cert_path | quote }}
set -gx DENO_CERT {{ .cert_path | quote }}
# JVM: zscaler is injected directly into the JDK's cacerts by
# run_onchange_rebuild-jvm-truststore.sh, so no JAVA_TOOL_OPTIONS needed.
{{ end -}}

# --- Aliases (from .chezmoidata/shell.yaml) ---
{{ range .shell.aliases -}}
{{ $req := index . "requires" -}}
{{ if $req -}}
if type -q {{ $req }}
    alias {{ .cmd }} {{ .expand | quote }}
end
{{ else -}}
alias {{ .cmd }} {{ .expand | quote }}
{{ end -}}
{{ end }}

# --- Fish-specific aliases (bass requires fish) ---
alias tf "bass scripts/iterraform.sh"
alias copilot "env SHELL={{ .brew_prefix }}/bin/bash copilot"
{{ if .work_apps -}}
alias eks-control-worker "~/working/tio-hm-ce-eks-control-worker/start-console.sh"
{{ end -}}

# --- Zoxide ---
if type -q zoxide
    zoxide init fish | source
end

# --- Starship prompt ---
if type -q starship
    starship init fish | source
end

# --- argc-completions ---
set -gx ARGC_COMPLETIONS_ROOT "$HOME/.config/argc-completions"
set -gx ARGC_COMPLETIONS_PATH "$ARGC_COMPLETIONS_ROOT/completions/macos:$ARGC_COMPLETIONS_ROOT/completions"
if test -d "$ARGC_COMPLETIONS_ROOT"
    set argc_scripts (ls -p -1 "$ARGC_COMPLETIONS_ROOT/completions/macos" "$ARGC_COMPLETIONS_ROOT/completions" 2>/dev/null | sed -n 's/\.sh$//p')
    if type -q argc
        argc --argc-completions fish $argc_scripts | source
    end
end

fish_vi_key_bindings

# Added by LM Studio CLI (lms)
set -gx PATH $PATH $HOME/.lmstudio/bin
# End of LM Studio CLI section

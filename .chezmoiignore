# Repo files — not dotfiles
README.md
AGENTS.md
LICENSE
*.plan.yaml
session-*.md

# opencode: typst build output (lives in repo for the source .typ, not deployed)
.config/opencode/out

# Emacs generated/state (also covered by .emacs.d/.gitignore)
.emacs.d/elpa
.emacs.d/eln-cache
.emacs.d/auto-save-list
.emacs.d/backups
.emacs.d/etc
.emacs.d/transient
.emacs.d/package-installed
.emacs.d/nerd-fonts-checked
.emacs.d/history
.emacs.d/.chatgpt-shell.el

# Fish: fisher-managed files (installed by run_onchange script)
.config/fish/functions/_pure_*
.config/fish/functions/__bass.py
.config/fish/functions/bass.fish
.config/fish/functions/fish_greeting.fish
.config/fish/functions/fish_mode_prompt.fish
.config/fish/functions/fish_prompt.fish
.config/fish/functions/fish_title.fish
.config/fish/conf.d/_pure_init.fish
.config/fish/conf.d/pure.fish

# Fish: machine-local state (but keep repo-managed completions)
.config/fish/fish_variables
.config/fish/completions/*
!.config/fish/completions/theme.fish

# Fish: tool-generated conf.d
.config/fish/conf.d/fish_frozen_key_bindings.fish
.config/fish/conf.d/fish_frozen_theme.fish
.config/fish/conf.d/uv.env.fish

# Sketchybar: generated from ghostty theme (run_after script regenerates)
.config/sketchybar/colors.sh
.config/sketchybar/colors.lua

# Theme pipeline: runtime state (managed by prot-theme)
.config/dotfiles/themes.json
.config/dotfiles/current-theme
.config/dotfiles/__pycache__

# Aerospace: editor state
.config/aerospace/.opencode

# Tuna: app state
Library/Application Support/Tuna/ClipboardHistory
Library/Application Support/Tuna/ExtensionStore
Library/Application Support/Tuna/FavoritesCache.json
Library/Application Support/Tuna/Mnemonics.plist
Library/Application Support/Tuna/PlugIns
Library/Application Support/Tuna/PlugInsDev
Library/Application Support/Tuna/ProxyHistory.plist

# aichat needs the AI API keys — only deploy where the toggle says so
{{ if not .ai_keys -}}
.config/aichat
{{ end -}}

# Zscaler root cert and generated bundle — corp_certs machines only
{{ if not .corp_certs -}}
.config/certs
{{ end -}}
# Generated bundle is never tracked (built by `dotfiles:certs:rebuild`)
.config/certs/bundle.pem

# OS junk
.DS_Store

# Ghostty: theme pipeline outputs (theme CLI regenerates)
.config/ghostty/themes
.config/ghostty/theme-current
